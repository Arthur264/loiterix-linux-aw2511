# Loiterix quiet boot - kernel native console loglevel default
# Sets default WITHOUT forcing CMDLINE - bootloader can override with loglevel=X or debug

# Default console loglevel (3 = KERN_ERR and above, suppresses info/debug)
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=3

# Loglevel when bootloader passes "quiet" flag (if used)
CONFIG_CONSOLE_LOGLEVEL_QUIET=3
