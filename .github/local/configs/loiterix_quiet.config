# Loiterix quiet boot - kernel config defaults only
# No custom logo patch, no cursor modification
# Userspace handles actual Loiterix logo rendering

# Default console loglevel (4 = print priority < 4: EMERG/ALERT/CRIT/ERR)
# Suppresses WARNING(4), NOTICE(5), INFO(6), DEBUG(7)
# Bootloader can override with explicit loglevel=X or debug
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4

# Loglevel when bootloader passes "quiet" flag (if used)
CONFIG_CONSOLE_LOGLEVEL_QUIET=4

# Disable built-in kernel logo display (stock penguin)
# Allows userspace to show actual Loiterix logo first
CONFIG_LOGO=n
