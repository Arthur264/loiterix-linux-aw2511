# Loiterix PWM: Linux sysfs PWM for the popcorn payload client
# Applied after loiterix_trim.config so a future trim cannot drop PWM.
# Allwinner PWM is CONFIG_AW_PWM (selects CONFIG_PWM). Do not use
# CONFIG_PWM_SUN4I — that is the mainline sun4i driver, not this BSP.

CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
CONFIG_AW_PWM=y
