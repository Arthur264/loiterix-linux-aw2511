# Loiterix power: CPU idle (PSCI) + DSU frequency scaling
# Appended after radxa_custom.config so it can re-enable idle if a future
# Radxa fragment turns it off again. Do not edit debian/patches/linux/0002*.

# Generic CPU idle (Radxa also sets this in radxa.config as of 6.6.98-5)
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_TEO=y

# PSCI firmware idle driver and hierarchical idle domains (cluster-sleep-0)
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y

# Allwinner DSU clock follows CPU OPP (sysfs: /sys/class/dsufreq)
# Requires CONFIG_AW_CPUFREQ_DT from bsp_defconfig
CONFIG_AW_SUNXI_DSUFREQ=y
