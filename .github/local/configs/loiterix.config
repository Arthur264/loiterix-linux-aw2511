# Loiterix unified kernel config fragment.
# Applied last in KERNEL_DEFCONFIG (after defconfig/radxa*/bsp).
# Do not edit debian/patches/linux/0001* or 0002* for Loiterix knobs.

# --- Quiet boot (kernel defaults; bootloader may still pass loglevel=)
# Default console loglevel 4 = print priority < 4 (EMERG/ALERT/CRIT/ERR)
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_CONSOLE_LOGLEVEL_QUIET=4
# Disable built-in penguin logo; userspace shows Loiterix branding
CONFIG_LOGO=n
CONFIG_PRINTK_CALLER=n

# --- Power: CPU idle (PSCI) + DSU frequency scaling
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
# Requires CONFIG_AW_CPUFREQ_DT from bsp_defconfig
CONFIG_AW_SUNXI_DSUFREQ=y
# Powersave workqueues (does not constrain performance governor)
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# --- Display / 2D (moved out of device bsp_defconfig)
CONFIG_AW_G2D=y
CONFIG_G2D_RCQ=y

# --- Restore in-tree AIC8800 (radxa.config prefers aic8800-dkms: AIC_WLAN_SUPPORT=n)
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC_LOADFW_SUPPORT=m

# --- Unused after radxa sync / Cubie A7Z drone
CONFIG_MD_RAID456=n
CONFIG_IDLE_INJECT=n
CONFIG_CPU_IDLE_THERMAL=n
CONFIG_VIDEO_AR0234=n
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_DVB_USB_V2=n
CONFIG_DVB_USB_AF9035=n
CONFIG_QCOM_PMIC_PDCHARGER_ULOG=n

# --- Audit: safe to disable (no Loiterix userspace / HAT use)
CONFIG_AW_INPUT_CTP=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_SND_SOC_AC101=n
CONFIG_SND_SOC_AC101B=n
CONFIG_SND_SOC_AW87XXX=n
CONFIG_SND_SOC_SUNXI_DEBUG=n
CONFIG_USB_SUNXI_USB_ADB=n
CONFIG_USB_CONFIGFS_RNDIS=n
CONFIG_USB_ANNOUNCE_NEW_DEVICES=n
CONFIG_USB_XHCI_DBGCAP=n
CONFIG_AW_POWER_DOMAIN_TEST=n

# HDMI VTX uses AW_DRM_HDMI_*; keep TCON_TV (HDMI timing via tv0/tcon3).
CONFIG_AW_DRM_EDP=n
CONFIG_AW_DRM_LVDS=n
CONFIG_AW_DRM_DSI=n

# Extra Bluetooth dongle stacks; onboard BT unused (ansible masks bluetooth)
CONFIG_BT_ATH3K=n
CONFIG_BT_MRVL=n
CONFIG_BT_MRVL_SDIO=n
CONFIG_BT_HCIBTUSB=n
CONFIG_BT_HCIBTSDIO=n
CONFIG_BT_MTKSDIO=n
CONFIG_AIC_BTUSB_SUPPORT=n

# Explicit keep of sensors/encode used by vidlik
CONFIG_VIDEO_IMX415=m
CONFIG_USB_VIDEO_CLASS=m
# Optional I2S MEMS codec symbol (board uses snd-soc-dummy; keep available)
CONFIG_SND_SOC_ICS43432=y

# --- Hang dumps / ramoops (pairs with reserved-memory in loiterix.dtsi)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- Size: debug/tracing (keep DEBUG_FS for ansible NPU/debugfs mount)
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_FUNCTION_GRAPH_TRACER=n
CONFIG_BOOTTIME_TRACING=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_PROFILING=n
CONFIG_SCHED_DEBUG=n
CONFIG_SLUB_DEBUG=n
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_DYNAMIC_DEBUG_CORE=n

# Allwinner driver dynamic debug (production drone)
CONFIG_AW_CCU_DEBUG=n
CONFIG_AW_CCMU_DYNAMIC_DEBUG=n
CONFIG_AW_PINCTRL_DYNAMIC_DEBUG=n
CONFIG_AW_UART_DYNAMIC_DEBUG=n
CONFIG_AW_TIMER_DYNAMIC_DEBUG=n
CONFIG_AW_GPADC_DYNAMIC_DEBUG=n
CONFIG_SND_SOC_SUNXI_DYNAMIC_DEBUG=n
CONFIG_AW_STANDBY_DEBUG=n
CONFIG_AW_POWER_DEBUG=n

# --- Size: filesystems / net extras Loiterix does not mount
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_IP_VS=n
CONFIG_USB_PRINTER=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_VFIO=n
CONFIG_UIO=n
CONFIG_NVME_TCP=n
CONFIG_SND_USB_AUDIO=n
