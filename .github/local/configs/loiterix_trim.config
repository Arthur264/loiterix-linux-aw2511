# Loiterix trim: drop unused options after radxa-pkg/linux-aw2511 sync.
# Applied last in KERNEL_DEFCONFIG. Do not edit debian/patches/linux/0001*.
# Keep CPU idle / PSCI / DSUFREQ (loiterix_power.config) and Loiterix I/O.

# --- Restore in-tree AIC8800 (radxa.config prefers aic8800-dkms: AIC_WLAN_SUPPORT=n)
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC_LOADFW_SUPPORT=m

# --- Newly enabled by radxa.config 6.6.98-5..7; unused on Cubie A7Z / vidlik
CONFIG_MD_RAID456=n
CONFIG_IDLE_INJECT=n
CONFIG_CPU_IDLE_THERMAL=n
CONFIG_VIDEO_AR0234=n
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_DVB_USB_V2=n
CONFIG_DVB_USB_AF9035=n
CONFIG_QCOM_PMIC_PDCHARGER_ULOG=n

# --- Audit: safe to disable (no Loiterix userspace / HAT use)
CONFIG_AW_INPUT_CTP=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_SND_SOC_AC101=n
CONFIG_SND_SOC_AC101B=n
CONFIG_SND_SOC_AW87XXX=n
CONFIG_USB_SUNXI_USB_ADB=n
CONFIG_USB_CONFIGFS_RNDIS=n

# HDMI VTX uses AW_DRM_HDMI_*; TCON_TV left on (HDMI timing path).
CONFIG_AW_DRM_EDP=n
CONFIG_AW_DRM_LVDS=n
CONFIG_AW_DRM_DSI=n

# Extra Bluetooth *dongle* stacks; onboard BT is unused (ansible masks bluetooth).
CONFIG_BT_ATH3K=n
CONFIG_BT_MRVL=n
CONFIG_BT_MRVL_SDIO=n
CONFIG_BT_HCIBTUSB=n
CONFIG_BT_HCIBTSDIO=n
CONFIG_BT_MTKSDIO=n
CONFIG_AIC_BTUSB_SUPPORT=n

# Explicit keep of sensors/encode used by vidlik (guards against =n elsewhere)
CONFIG_VIDEO_IMX415=m
CONFIG_USB_VIDEO_CLASS=m
