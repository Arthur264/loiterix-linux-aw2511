From bf536daf566bd139162da2353ed0eaea384e46c8 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 7 Nov 2026 18:24:24 +0000
Subject: [PATCH] feat: Add Loiterix boot splash logo and configuration

- Replace kernel logo with authentic Loiterix horizontal logo (824x144, 103:18 aspect)
- Add radxa_splash.config with framebuffer console and logo support
- Enable DRM/KMS framebuffer emulation for Allwinner display
- Configure for quiet boot with serial console diagnostics preserved

Source: Figma export from Logo Kit (node 1:6)
Converted to CLUT224 PPM format for kernel logo system
Dimensions: 512x89 (scaled from 824x144, maintaining aspect ratio)

Required boot parameters:
  console=tty1 console=ttyS0,115200n8 quiet loglevel=3 vt.global_cursor_default=0

Serial console remains available for debugging.
Boot logs preserved via journalctl.
Debug mode accessible by removing 'quiet' parameter.
---
 arch/arm64/configs/radxa_splash.config    |  57 ++++++++++++++++++++++
 drivers/video/logo/logo_linux_clut224.ppm | Bin 76845 -> 136718 bytes
 2 files changed, 57 insertions(+)
 create mode 100644 arch/arm64/configs/radxa_splash.config

diff --git a/arch/arm64/configs/radxa_splash.config b/arch/arm64/configs/radxa_splash.config
new file mode 100644
index 000000000000..c758af6cf06c
--- /dev/null
+++ b/arch/arm64/configs/radxa_splash.config
@@ -0,0 +1,57 @@
+# Loiterix Boot Splash Configuration
+# Enables framebuffer console with kernel logo for quiet boot experience
+#
+# This configuration enables:
+# - Framebuffer console support
+# - Kernel boot logo (replaced with Loiterix logo)
+# - DRM/KMS framebuffer emulation
+# - Allwinner display engine support
+#
+# Required boot parameters:
+#   console=tty1 console=ttyS0,115200n8 quiet loglevel=3 vt.global_cursor_default=0
+#
+# Serial console (ttyS0) remains available for diagnostics
+# Boot logs preserved in journalctl
+# Debug mode: remove 'quiet' parameter at boot
+
+# Framebuffer Console Support
+CONFIG_FB=y
+CONFIG_FB_CORE=y
+CONFIG_FIRMWARE_EDID=y
+CONFIG_FB_NOTIFY=y
+CONFIG_FB_CMDLINE=y
+CONFIG_FB_SIMPLE=y
+
+# Framebuffer Console
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
+
+# VT Console
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+CONFIG_VT_HW_CONSOLE_BINDING=y
+
+# DRM Core for modern display drivers
+CONFIG_DRM=y
+CONFIG_DRM_KMS_HELPER=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_DRM_FBDEV_OVERALLOC=200
+
+# Allwinner Display Engine (DRM driver for A7)
+CONFIG_DRM_SUN4I=y
+CONFIG_DRM_SUN4I_BACKEND=y
+CONFIG_DRM_SUN8I_DW_HDMI=y
+CONFIG_DRM_SUN8I_MIXER=y
+CONFIG_DRM_SUN8I_TCON_TOP=y
+
+# Kernel Boot Logo
+CONFIG_LOGO=y
+CONFIG_LOGO_LINUX_CLUT224=y
+
+# Disable other architecture-specific logos
+# CONFIG_LOGO_LINUX_MONO is not set
+# CONFIG_LOGO_LINUX_VGA16 is not set
+
+# Ensure console is available early
+CONFIG_EARLY_PRINTK=y
