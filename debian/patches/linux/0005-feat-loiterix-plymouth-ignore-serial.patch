From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 9 Nov 2026 19:45:00 +0000
Subject: [PATCH] feat: ship plymouth.ignore-serial-consoles via linux-image

linux-image-*-aw2511 is built by scripts/package/builddeb (bindeb-pkg).
Install a u-boot-menu conf.d fragment there so zz-u-boot-menu sees it.
The fragment fills U_BOOT_PARAMETERS from /etc/kernel/cmdline when empty
(board cmdline has root=, so radxa.conf does not set it).

---
 src/scripts/package/builddeb                  |  7 ++++++
 src/scripts/package/zz-loiterix-plymouth.conf | 17 ++++++++++++++
 2 files changed, 24 insertions(+)
 create mode 100644 src/scripts/package/zz-loiterix-plymouth.conf

diff --git a/src/scripts/package/builddeb b/src/scripts/package/builddeb
index d7dd0d04c70c..5ae4d578b502 100755
--- a/src/scripts/package/builddeb
+++ b/src/scripts/package/builddeb
@@ -119,6 +119,13 @@ install_linux_image () {
 		EOF
 		chmod 755 "${pdir}/DEBIAN/${script}"
 	done
+
+	# linux-image-*-aw2511 is produced here (bindeb-pkg), not the
+	# linux-image-radxa-a733 meta-package. Ship the u-boot-menu fragment
+	# so zz-u-boot-menu (run-parts from this postinst) sees it.
+	mkdir -p "${pdir}/usr/share/u-boot-menu/conf.d"
+	cp "${srctree}/scripts/package/zz-loiterix-plymouth.conf" \
+		"${pdir}/usr/share/u-boot-menu/conf.d/zz-loiterix-plymouth.conf"
 }
 
 install_linux_image_dbg () {
diff --git a/src/scripts/package/zz-loiterix-plymouth.conf b/src/scripts/package/zz-loiterix-plymouth.conf
new file mode 100644
index 000000000000..b7ff86ea37e8
--- /dev/null
+++ b/src/scripts/package/zz-loiterix-plymouth.conf
@@ -0,0 +1,17 @@
+# Sourced by u-boot-menu read-config from /usr/share/u-boot-menu/conf.d/.
+# Board cmdline has root=, so radxa.conf leaves U_BOOT_PARAMETERS empty and
+# read-config would fill it later — too late to append. Populate the same
+# way read-config does, then add plymouth.ignore-serial-consoles (serial
+# consoles stay on the cmdline).
+if [ -z "${U_BOOT_PARAMETERS}" ] && [ -f /etc/kernel/cmdline ]; then
+	U_BOOT_PARAMETERS="$(cat /etc/kernel/cmdline | sed -e 's/root=[^[:space:]]*//' -e 's/^[[:space:]]*//')"
+	if [ -z "${U_BOOT_ROOT}" ]; then
+		U_BOOT_ROOT="$(cat /etc/kernel/cmdline | sed -re 's/.*(root=[^[:space:]]*).*/\1/')"
+	fi
+fi
+if [ -n "${U_BOOT_PARAMETERS}" ]; then
+	case " ${U_BOOT_PARAMETERS} " in
+	*" plymouth.ignore-serial-consoles "*) ;;
+	*) U_BOOT_PARAMETERS="${U_BOOT_PARAMETERS} plymouth.ignore-serial-consoles" ;;
+	esac
+fi
